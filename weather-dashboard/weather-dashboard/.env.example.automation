# ---- add these to weather-dashboard/weather-dashboard/.env.local (never commit values) ----

# Master switch for the worker. Nothing runs unless this is exactly "true".
AUTOMATION_ENABLED=false

# Supabase (placeholders: fill in yourself). Server-only, never expose the service-role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# PolyBot link. The secret must match WEATHER_INTENT_SECRET on PolyBot.  Generate with: openssl rand -hex 32
POLYBOT_BUY_URL=
POLYBOT_INTENT_SECRET=
# POLYBOT_TIMEOUT_MS=20000

# Cloudflare Access (admin pages and /api/automation/* except /tick)
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
AUTOMATION_ADMIN_EMAILS=

# Shared with the cron line that calls /api/automation/tick. At least 16 characters.
AUTOMATION_CRON_SECRET=

# Already used by the dashboard
# MONGO_URI=

# Optional tuning (defaults shown)
# AUTOMATION_MAX_SIGNAL_AGE_MIN=12
# AUTOMATION_CLOSE_GRACE_MIN=20
# AUTOMATION_MAX_BUYS_PER_RULE_CITY_DAY=3
# AUTOMATION_ALLOWED_ORIGINS=
# AUTOMATION_DEV_BYPASS=1      # local dev only, ignored when NODE_ENV=production

# Do NOT reuse DISCORD_WEBHOOK_URL for alerts. n8n reads that channel and turns messages into ticks.
